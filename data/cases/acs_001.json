  "rubric_ref": {
    "rubric_id": "acs_001_rubric",
    "version": "v1"
  },
  "safety_notes": "本病例仅用于医学教育模拟，不替代真实诊疗决策。",
  "teaching_focus": {
    "learning_objectives": [
      "围绕胸痛起病时间、诱因、性质、持续时间和放射部位建立缺血性胸痛线索链。",
      "主动追问高血压、吸烟等心血管危险因素，并与生命体征异常结合判断风险背景。",
      "能将心电图 ST 段改变和肌钙蛋白升高作为客观证据，与病史线索共同支持诊断假设。",
      "在提出高危缺血性胸痛诊断方向时同步说明主动脉夹层、胃食管反流等鉴别诊断的排除依据。"
    ],
    "common_error_patterns": [
      {
