    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["auxiliary_test"],
    "source_id": "aha_acc_chest_pain_guideline_2021",
    "title": "胸痛辅助检查：心电图与心肌损伤证据优先",
    "text": "提交诊断前，Coach 可提示学生优先申请心电图和心肌损伤标志物，再根据疼痛特征、生命体征和鉴别方向考虑胸部影像或其他检查。引导重点是说明每项检查要回答的问题，不提前解读未申请结果。",
    "tags": ["chest_pain", "ecg", "troponin", "auxiliary_test", "coach_hint"],
    "version": 1
  },
  {
    "knowledge_id": "case:heart_failure_001:coach:dyspnea_volume_history_sequence",
    "scope": "case",
    "case_id": "heart_failure_001",
    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["case_intro", "history_taking"],
    "source_id": "aha_acc_hf_guideline_2022",
    "title": "气短水肿问诊：把活动耐量、夜间憋醒和容量线索串起来",
    "text": "提交诊断前，Coach 可提示学生追问呼吸困难出现时间、活动耐量变化、平卧是否加重、夜间憋醒、咳嗽咳痰、下肢水肿、体重变化、尿量、用药依从性、盐水摄入和既往心血管病史；同时询问发热、胸痛、喘鸣等鉴别线索，但不提前给出诊断名称。",
    "tags": ["dyspnea", "edema", "history_taking", "coach_hint"],
    "version": 1
  },
  {
    "knowledge_id": "case:heart_failure_001:coach:dyspnea_exam_sequence",
    "scope": "case",
    "case_id": "heart_failure_001",
    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["physical_exam"],
    "source_id": "aha_acc_hf_guideline_2022",
    "title": "气短水肿查体：系统寻找心肺和容量体征",
    "text": "提交诊断前，Coach 可引导学生查看呼吸频率、血氧、血压和心率，再检查颈静脉、肺底啰音、附加心音、肝颈回流和下肢凹陷性水肿。这些体征需结合病史理解，单一体征不应被当作标准答案。",
    "tags": ["dyspnea", "edema", "physical_exam", "volume_status", "coach_hint"],
    "version": 1
  },
  {
    "knowledge_id": "case:heart_failure_001:coach:dyspnea_test_sequence",
    "scope": "case",
    "case_id": "heart_failure_001",
    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["auxiliary_test"],
    "source_id": "aha_acc_hf_guideline_2022",
    "title": "气短水肿辅助检查：从心脏标志物到结构功能",
    "text": "提交诊断前，Coach 可提示学生用 BNP 或 NT-proBNP 评估心脏负荷线索，用超声心动图了解结构与功能，并结合胸部影像、心电图、血常规和心肌损伤标志物检查诱因与鉴别方向。检查选择用于组织证据链，不输出真实治疗建议。",
    "tags": ["dyspnea", "bnp", "echocardiography", "auxiliary_test", "coach_hint"],
    "version": 1
  },
  {
    "knowledge_id": "case:hyperthyroid_001:coach:palpitation_weight_history_sequence",
    "scope": "case",
    "case_id": "hyperthyroid_001",
    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["case_intro", "history_taking"],
    "source_id": "ata_hyperthyroidism_guideline_2016",
    "title": "心悸消瘦问诊：把代谢、交感兴奋和颈部眼部线索连起来",
    "text": "提交诊断前，Coach 可提示学生追问心悸频率、手抖、怕热多汗、体重变化、食欲、睡眠、情绪、排便次数、月经变化、颈部肿大、眼部不适，以及碘剂、胺碘酮或相关用药暴露；提示重点是系统采集症状簇和诱因，不提前给出诊断名称。",
    "tags": ["palpitation", "weight_loss", "heat_intolerance", "coach_hint"],
    "version": 1
  },
  {
    "knowledge_id": "case:hyperthyroid_001:coach:palpitation_exam_sequence",
    "scope": "case",
    "case_id": "hyperthyroid_001",
    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["physical_exam"],
    "source_id": "ata_hyperthyroidism_guideline_2016",
    "title": "心悸消瘦查体：寻找高代谢与甲状腺相关体征",
    "text": "提交诊断前，Coach 可引导学生检查心率、心律和脉压，观察手部细颤、皮肤温湿和眼部表现，并完成甲状腺视诊、触诊与必要的听诊。这些体征用于组织症状簇，不应单独确定标准答案。",
    "tags": ["palpitation", "tremor", "thyroid_exam", "physical_exam", "coach_hint"],
    "version": 1
  },
  {
    "knowledge_id": "case:hyperthyroid_001:coach:palpitation_test_sequence",
    "scope": "case",
    "case_id": "hyperthyroid_001",
    "content_kind": "coach_hint_note",
    "visibility": "pre_submit_safe",
    "allowed_agents": ["coach"],
    "stage_scope": ["auxiliary_test"],
    "source_id": "ata_hyperthyroidism_guideline_2016",
    "title": "心悸消瘦辅助检查：先确认功能状态再寻找病因线索",
    "text": "提交诊断前，Coach 可提示学生先选择 TSH 和游离 T4，必要时补充 T3，再根据病史和查体考虑相关抗体与甲状腺影像。应要求学生说明“功能是否异常”与“可能原因”是两个不同问题，不提前展示未申请结果。",
    "tags": ["palpitation", "tsh", "ft4", "thyroid_antibody", "auxiliary_test"],
    "version": 1
  },
  {
    "knowledge_id": "case:pneumonia_001:coach:cough_fever_history_sequence",
    "scope": "case",
    "case_id": "pneumonia_001",
