# Model
CLINICAL_OSCE_DEPLOYMENT_MODE=local-demo
CLINICAL_OSCE_BIND_HOST=127.0.0.1
CLINICAL_OSCE_TRUSTED_BROWSER_ORIGINS=http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3100,http://127.0.0.1:8000
CLINICAL_OSCE_SERVER_MANAGED_MODEL_CONFIG=true
CLINICAL_OSCE_ACCOUNT_MODEL_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
CLINICAL_OSCE_ALLOW_UNSAFE_ACCOUNT_MODEL_ENDPOINTS=false
OSCE_ANTHROPIC_ENABLED=false
OSCE_ANTHROPIC_API_KEY=
OSCE_ANTHROPIC_BASE_URL=https://api.anthropic.com
OSCE_ANTHROPIC_MODEL=
OSCE_ANTHROPIC_PROXY_URL=direct
OSCE_GEMINI_PATIENT_API_KEY=
OSCE_GEMINI_PATIENT_USE_VERTEX=false
OSCE_GEMINI_PATIENT_PROJECT=
OSCE_GEMINI_PATIENT_LOCATION=global
OSCE_GEMINI_PATIENT_MODEL=gemini-3.5-flash
OSCE_GEMINI_PATIENT_PROXY_URL=http://127.0.0.1:7897
OSCE_VERTEX_ENABLED=false
OSCE_VERTEX_API_KEY=
OSCE_VERTEX_PROJECT=
OSCE_VERTEX_LOCATION=global
OSCE_VERTEX_MODEL=gemini-3.5-flash
OSCE_VERTEX_SKILL_CANDIDATE_ENABLED=false
OSCE_VERTEX_SKILL_CANDIDATE_MODEL=gemini-3.5-flash
OSCE_VERTEX_PROXY_URL=http://127.0.0.1:7897
OSCE_VERTEX_EMBEDDING_ENABLED=true
OSCE_VERTEX_EMBEDDING_PROJECT=
OSCE_VERTEX_EMBEDDING_LOCATION=global
OSCE_VERTEX_EMBEDDING_MODEL=gemini-embedding-001
OSCE_VERTEX_EMBEDDING_OUTPUT_DIMENSIONALITY=3072
OSCE_VERTEX_EMBEDDING_PROXY_URL=http://127.0.0.1:7897
# Vertex embed_content requests are split by item count and serialized UTF-8 bytes.
# Invalid values use these defaults; hard caps are 250 items and 262144 bytes.
OSCE_VERTEX_EMBEDDING_BATCH_SIZE=32
OSCE_VERTEX_EMBEDDING_BATCH_MAX_BYTES=65536
OSCE_OPENAI_ENABLED=true
OSCE_OPENAI_API_KEY=
OSCE_OPENAI_BASE_URL=https://your-managed-gateway.example/v1
OSCE_OPENAI_MODEL=gemini-3.5-flash
OSCE_OPENAI_PROXY_URL=direct
OSCE_OPENAI_FALLBACK_ENABLED=false
OSCE_OPENAI_FALLBACK_API_KEY=
OSCE_OPENAI_FALLBACK_BASE_URL=https://your-fallback-gateway.example/v1
OSCE_OPENAI_FALLBACK_MODEL=mimo-v2.5-pro
OSCE_OPENAI_FALLBACK_PROXY_URL=direct
# A different origin receives the same clinical payload; enable only after
# explicitly approving that destination. Account-scoped providers never inherit it.
OSCE_OPENAI_FALLBACK_ALLOW_CROSS_PROVIDER=false
# Shared hard wall-clock budget for each model-bound API request.
OSCE_MODEL_CALL_TIMEOUT_SECONDS=30
# Shared admission and blocking-provider concurrency limit. Excess work gets 503.
OSCE_MODEL_CALL_MAX_CONCURRENCY=8
OSCE_LOCAL_EMBEDDING_ENABLED=true
OSCE_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
OSCE_LOCAL_EMBEDDING_DEVICE=cpu

# Speech input / output
# Used by the OSCE voice composer and patient reply playback.
# Keep the key only on the API server. The browser calls /api/audio/* through the web proxy.
OSCE_DASHSCOPE_SPEECH_API_KEY=
# DASHSCOPE_API_KEY= can also be used as a shared fallback key.
OSCE_DASHSCOPE_ASR_MODEL=qwen3-asr-flash
OSCE_DASHSCOPE_TTS_MODEL=qwen3-tts-flash
OSCE_DASHSCOPE_TTS_VOICE=Serena
OSCE_DASHSCOPE_SPEECH_PROXY_URL=direct
OSCE_DASHSCOPE_SPEECH_TIMEOUT_SECONDS=60

# Local demo admin
CLINICAL_OSCE_ADMIN_EMAILS=
CLINICAL_OSCE_DEMO_ADMIN_ENABLED=false
CLINICAL_OSCE_DEMO_ADMIN_EMAIL=
CLINICAL_OSCE_DEMO_ADMIN_PASSWORD=
CLINICAL_OSCE_DEMO_STUDENT_ENABLED=false
CLINICAL_OSCE_DEMO_STUDENT_EMAIL=
CLINICAL_OSCE_DEMO_STUDENT_PASSWORD=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Database
DATABASE_URL=sqlite:///./clinical_osce.db

# Vector store
OSCE_CHROMA_ENABLED=true
CHROMA_PERSIST_DIRECTORY=./data/processed/chroma
OSCE_CHROMA_COLLECTION=clinical_osce_retrieval
# Positive integer. Higher values reduce approximate-search misses at the cost of more query work.
OSCE_CHROMA_SEARCH_EF=500
